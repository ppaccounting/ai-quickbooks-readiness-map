rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Readiness Map submissions are accessible only through trusted server code.
    match /readiness_submissions/{submissionId} {
      allow read, write: if false;
    }
    // Existing weeklyCheckins permissions must be confirmed separately.
    // Do not publish this file until the Routine Builder rules are corrected.
  }
}
